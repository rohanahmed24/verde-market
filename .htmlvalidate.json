{
  "extends": ["html-validate:recommended"],
  "elements": ["html5"],
  "rules": {
    "require-sri": "off",
    "no-inline-style": "off",
    "void-style": "off",
    "attribute-empty-style": "off",
    "attribute-boolean-style": "off",
    "no-implicit-button-type": "error",
    "no-implicit-input-type": "off",
    "element-permitted-content": "off",
    "unique-landmark": "warn",
    "wcag/h32": "off"
  }
}
